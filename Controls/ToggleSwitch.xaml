<UserControl x:Class="ShutUp11.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="22" Width="44" Cursor="Hand">
    <Grid>
        <Border x:Name="Track" CornerRadius="11">
            <Border.Background>
                <SolidColorBrush x:Name="TrackBrush" Color="#E64A19"/>
            </Border.Background>
        </Border>
        <Ellipse x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0,0,0">
            <Ellipse.Fill>
                <SolidColorBrush Color="#FFFFFF"/>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect x:Name="Glow" Color="#00FF88" BlurRadius="0" ShadowDepth="0" Opacity="0.95"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>