<UserControl x:Class="ShutUp11.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ShutUp11.Controls">
    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#C0C0C5"/>
            <Setter Property="BorderBrush" Value="#2E2E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A30"/>
                                <Setter Property="BorderBrush" Value="#3E3E46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#141418"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApplyButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#00C853"/>
            <Setter Property="BorderBrush" Value="#00C85340"/>
        </Style>
        <Style x:Key="DeclineButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#FF6B35"/>
            <Setter Property="BorderBrush" Value="#FF6B3540"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#141416">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Üst Araç Çubuğu -->
        <Border Grid.Row="0" Background="#0F0F12" BorderBrush="#232327" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="CategoryLabel" Text="Ayarlar" Foreground="#E6E6E6"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountLabel" Text="" Foreground="#5A5A5E"
                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ApplyRecommendedBtn" Content="✓ Önerilen Ayarları Seç"
                            Style="{StaticResource ApplyButtonStyle}"
                            Click="ApplyRecommended_Click" Margin="0,0,6,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sütun Başlıkları -->
        <Border Grid.Row="1" Background="#0C0C0E" BorderBrush="#1A1A1C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Durum" Foreground="#5A5A5E"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Ayar" Foreground="#5A5A5E"
                           VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="Bilgi" Foreground="#5A5A5E"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="Son Değişiklik" Foreground="#5A5A5E"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="4" Text="Öneri" Foreground="#5A5A5E"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,20,0" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Liste -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,10" BorderBrush="#1A1A1C" BorderThickness="0,0,0,1"
                                x:Name="RowBorder">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18181B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <ctrl:ToggleSwitch Grid.Column="0"
                                                   IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                   HorizontalAlignment="Left"
                                                   Margin="16,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding Description}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" Foreground="#E6E6E6"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text=" 🛡" Foreground="#FFB300" FontSize="11"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Visibility="{Binding RequiresAdminVisibility}"/>
                                        <TextBlock Text=" 🔄" Foreground="#42A5F5" FontSize="11"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                   Visibility="{Binding RequiresRestartVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Category}" Foreground="#5A5A5E"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding InfoTag}"
                                           Foreground="#5A5A5E" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3" Text="{Binding LastChanged}"
                                           Foreground="#5A5A5E" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,0,20,0"
                                            VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding RecommendationColor}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Recommendation}"
                                               Foreground="#D0D0D0" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Alt Onay/İptal Çubuğu -->
        <Border Grid.Row="3" Background="#0C0C0E" BorderBrush="#1A1A1C" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="DeclineBtn" Content="Decline (Vazgeç)" Width="120" Height="34"
                        Style="{StaticResource DeclineButtonStyle}"
                        Click="DeclineBtn_Click" Margin="0,0,12,0"/>
                <Button x:Name="ApplyBtn" Content="Apply (Uygula)" Width="120" Height="34"
                        Style="{StaticResource ApplyButtonStyle}"
                        Click="ApplyBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
