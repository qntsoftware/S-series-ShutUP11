<UserControl x:Class="ShutUp11.Views.ServicesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ShutUp11.Controls">
    <Grid Background="#141416">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12" Background="#0F0F12" BorderBrush="#232327" BorderThickness="0,0,0,1">
            <Grid>
                <TextBox x:Name="FilterBox" Background="#1A1A1D" Foreground="#E6E6E6" BorderThickness="0"
                         CaretBrush="#E6E6E6" Padding="10,6" FontSize="12" Height="28"
                         VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
                <TextBlock x:Name="FilterPlaceholder" Text="Filter services..." Foreground="#5A5A5E"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" FontSize="12"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0F0F12" BorderBrush="#232327" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Service" Foreground="#9A9A9E" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="Display Name" Foreground="#9A9A9E" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="Data" Foreground="#9A9A9E" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="On/Off" Foreground="#9A9A9E" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <ListView x:Name="ServiceList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                  Foreground="#E6E6E6" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E6E6E6" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#B0B0B5" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="📤" Foreground="#FFD93D" FontSize="12" Margin="0,0,6,0"
                                                       Visibility="{Binding SendsData, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding StartType}" Foreground="#9A9A9E" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ctrl:ToggleSwitch Grid.Column="3"
                                                           IsOn="{Binding IsRunning, Mode=OneWay}"
                                                           Tag="{Binding Name}"
                                                           HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center"
                                                           Toggled="ServiceToggle_Toggled"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A1A1D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border Grid.Row="3" Background="#0F0F12" BorderBrush="#232327" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Foreground="#9A9A9E" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>